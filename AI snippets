    // Expose this Action to the Flow
     @InvocableMethod(label='Get Weather Action' description='Get All Weather Data')   
    public static List<List<WeatherRecord>> getAll(List<String> indata) {

        // Prepare the response to send back to the Flow

        List<List<WeatherRecord>> responseWrapper = new List<List<WeatherRecord>>();
 
        
        ConnectApi.CdpQueryInput input = new ConnectApi.CdpQueryInput();
        input.sql = 'select zip__c, forecast_date__c, weather_forecast__c from SnowflakeWeatherTable2DMO__dlm limit 100';
        System.debug('query=' + input.sql);
        
        ConnectApi.CdpQueryOutputV2 output = ConnectApi.CdpQuery.queryAnsiSqlV2(input);
        
        List<WeatherRecord> collectionOutput = new List<WeatherRecord>();
        for (ConnectApi.CdpQueryV2Row row : output.data){
            WeatherRecord response = new WeatherRecord();
            response.zip = (String)row.rowData[0];
            response.forecastDate = (String)row.rowData[1];
            response.forecast = (String)row.rowData[2];

            collectionOutput.add(response);
        }            
               
         
        responseWrapper.add(collectionOutput);
 
        // Return values back to the Flow
        return responseWrapper;
    }          
}

