// Method to parse CSV string and return a list of Account objects
    public static List< Iot_Anomaly__c> parseCSV(String csvString) {
    
        Log__c log = new Log__c ();
        log.log__c = csvString;
        insert log;
    
        List< Iot_Anomaly__c> ias = new List<Iot_Anomaly__c>();
        List<String> rows = csvString.split('\n');
                
        // Assume the first row is the header
        if (rows.size() > 0) {
            // Iterate over each row after the header
            for (Integer i = 1; i < rows.size(); i++) {
                String row = rows[i];
        
                List<String> columns = row.split(',');
                
                // Ensure the row has the correct number of columns
                if (columns.size() > 1) {
                    Iot_Anomaly__c ia = new Iot_Anomaly__c();
                    ia.Name = columns[0];                   
                    
                    switch on columns[1] {
                        when 'gas' {
                            ia.Gas_Anomaly__c=true;
                        }
                        when 'temperature' {
                            ia.Temperature_Anomaly__c = true;
                        }
                        when 'humidity' {
                            ia.Humidity_Anomaly__c = true;
                        }
                        when 'pressure' {
                            ia.Pressure_Anomaly__c = true;
                        }
                    }
                                                            
                    
                    ias.add(ia);
                    
                } else {
                    System.debug('Row ' + i + ' has an incorrect number of columns: ' + row);
                }
            }
        } else {
            System.debug('CSV string is empty or does not contain any data rows.');
        }
        
        return ias;
    }

    // Expose this Action to the Flow
     @InvocableMethod(label='Process Iot Anomaly Data' description='Process Iot Anomaly Data')   
    public static List<String> processIotAnomalyData(List<String> indata) {

        // Prepare the response to send back to the Flow
        List<String> responseWrapper = new List<String>();

       List<Iot_Anomaly__c> ias = parseCSV(indata[0]);
        
        // Insert accounts into Salesforce
        try {
            
            upsert ias Name;
            
            System.debug('IoT Anomaly upserted successfully.');
        } catch (DmlException e) {
            System.debug('An error occurred while IoT Anomaly upsert ' + e.getMessage());
        }
        
        responseWrapper.add(ias.size().toString());        
 
        // Return values back to the Flow
        return responseWrapper;
    }          
}

